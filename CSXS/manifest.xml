<?xml version="1.0" encoding="UTF-8"?>
<ExtensionManifest Version="12.0"
    ExtensionBundleId="com.hermes.storyboard"
    ExtensionBundleVersion="1.0.0"
    ExtensionBundleName="Storyboard Screenshot Tool">

    <ExtensionList>
        <Extension Id="com.hermes.storyboard.panel" Version="1.0.0"/>
    </ExtensionList>

    <ExecutionEnvironment>
        <HostList>
            <Host Name="PPRO" Version="[23.0,99.0]"/>
        </HostList>
        <LocaleList>
            <Locale Code="All"/>
        </LocaleList>
        <RequiredRuntimeList>
            <RequiredRuntime Name="CSXS" Version="12.0"/>
        </RequiredRuntimeList>
    </ExecutionEnvironment>

    <DispatchInfoList>
        <Extension Id="com.hermes.storyboard.panel">
            <DispatchInfo>
                <Resources>
                    <MainPath>./index.html</MainPath>
                </Resources>
                <Lifecycle>
                    <AutoVisible>true</AutoVisible>
                </Lifecycle>
                <UI>
                    <Type>Panel</Type>
                    <Menu>拉片截图工具</Menu>
                    <Geometry>
                        <Size>
                            <Width>320</Width>
                            <Height>360</Height>
                        </Size>
                    </Geometry>
                </UI>
            </DispatchInfo>
        </Extension>
    </DispatchInfoList>
</ExtensionManifest>
